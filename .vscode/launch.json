    { "name": "CNN: train (local)", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/cnn-sagemaker/train.py", "cwd": "${workspaceFolder}/cnn-sagemaker" },
    { "name": "Sentiment: train", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/sentiment-nlp/src/train.py", "cwd": "${workspaceFolder}/sentiment-nlp" }
