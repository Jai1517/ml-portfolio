  "version": "0.2.0",
  "configurations": [
    { "name": "RAG API (FastAPI)", "type": "debugpy", "request": "launch", "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"], "cwd": "${workspaceFolder}/rag-document-qa", "envFile": "${workspaceFolder}/.env" },
